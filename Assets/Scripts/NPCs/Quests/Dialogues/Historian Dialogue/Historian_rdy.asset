  nodes:
  - id: historian_rdy
    text: I CAN'T BELIEVE IT!!! You found the left shoe of Napoleon the Third! I
      have to bring this to the museum immediately! Now if you will excuse me!
    choices:
    - label: My fair share
      nextNodeID: historian_rew
