    actionsOnEnter:
    - {fileID: 11400000, guid: 77c19e84b527e47ef94ad0a9add89b6c, type: 2}
    wwiseEvent:
      idInternal: 0
      valueGuidInternal: 
      WwiseObjectReference: {fileID: 0}
  - id: kid_reference
    text: Wow you are real nerd! Maybe you can be as bold as General Kenobi and help
      me find Miss Froggy, Doctor Shepperd, Mister Roach and The Kid
