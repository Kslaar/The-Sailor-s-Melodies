      actionsOnChoose: []
      wwiseEvent:
        idInternal: 0
        valueGuidInternal: 
        WwiseObjectReference: {fileID: 0}
    actionsOnEnter:
    - {fileID: 0}
    wwiseEvent:
      idInternal: 0
      valueGuidInternal: 
      WwiseObjectReference: {fileID: 0}
  - id: hilfe_zugesagt
    text: We pray for your quick return!
    choices:
